generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TaskStatus {
  IN_PROGRESS
  COMPLETED
  PENDING
}

model ProductionOrder {
  id        Int                @id @default(autoincrement())
  product   String
  quantity  Int
  status    TaskStatus?        @default(PENDING)
  dueDate   DateTime
  machineId Int
  customer  String
  createdAt DateTime           @default(now())
  records   ProductionRecord[]
}

model ProductionRecord {
  id                Int             @id @default(autoincrement())
  productionOrderId Int
  order             ProductionOrder @relation(fields: [productionOrderId], references: [id])
  machineId         Int
  machine           Machine         @relation(fields: [machineId], references: [id])
  passedCount       Int
  failedCount       Int
  remark            String?
  producedAt        DateTime        @default(now())
}

enum MachineStatus {
  NORMAL
  ERROR
  PENDING
}

model Machine {
  id                Int                @id @default(autoincrement())
  name              String
  status            MachineStatus?     @default(PENDING)
  temp              Int?
  load              Int?
  time              DateTime?
  maintenance       MaintenanceLog[]
  productionRecords ProductionRecord[]
}

model MaintenanceLog {
  id         Int      @id @default(autoincrement())
  machineId  Int
  machine    Machine  @relation(fields: [machineId], references: [id])
  issue      String
  repairedAt DateTime @default(now())
}

enum StockLevel {
  LOW
  NORMAL
  OUT_OF_STOCK
}

model Inventory {
  id           Int         @id @default(autoincrement())
  itemName     String
  quantity     Int         @default(0)
  minimumStock Int?        @default(0)
  unit         String
  stockLevel   StockLevel? @default(LOW)
  createdAt    DateTime    @default(now())
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id       String   @id @default(uuid())
  username String   @unique
  password String
  role     UserRole @default(USER)
}
